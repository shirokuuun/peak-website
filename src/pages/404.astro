---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout title="Page not found — Peak">
  <section class="not-found wrap">
    <span>404 / A SMALL DETOUR</span>
    <h1>
      This page stepped
      <br />
      <span class="heading-emphasis">out of view.</span>
    </h1>
    <p>Let’s get you back to the desktop.</p>
    <a href="/" class="button button-primary">
      Back to Peak <Icon name="arrow" size={17} />
    </a>
  </section>
</Layout>
