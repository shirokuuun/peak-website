---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import PeakDemo from '../components/PeakDemo';
import Story from '../components/Story.astro';
import Film from '../components/Film.astro';
import SettingsGallery from '../components/SettingsGallery.astro';
import DownloadCta from '../components/DownloadCta.astro';
const faqs = [
  [
    'What does Peak monitor?',
    'Peak shows Codex and Claude subscription usage. Codex also supports local task activity, questions, and reported review requests. Claude task or approval monitoring is not included.',
  ],
  [
    'Is Peak really free?',
    'Peak is freeware for personal and workplace use on unlimited devices, with no Peak account, activation, or expiry. Your own compatible provider tools and subscriptions are required for live readings.',
  ],
  [
    'Does it change or approve my AI tasks?',
    'No. Peak observes local activity. It does not start model turns or grant approvals. Review requests and questions are answered in Codex. Reports can become stale or be cleared elsewhere.',
  ],
  [
    'What happens to my data?',
    'Providers start disabled. After consent, Peak reads the relevant local interfaces and keeps bounded observations on your computer. Peak has no remote usage backend or telemetry. Provider tools can make their own authenticated requests. See the privacy notice for retention and hosting details.',
  ],
  [
    'Can I make it less visible?',
    'Choose Always, When active, or On hover. Configure fullscreen behavior, pointer fading, a reveal shortcut, and optional capture exclusion. Screen-sharing behavior depends on the capture tool, so check it before sharing.',
  ],
  [
    'How will I get updates?',
    'Download a verified installer or portable ZIP from this website. Updates are manual. Peak does not silently download or install them.',
  ],
];
---

<Layout>
  <noscript>
    <p class="notice-banner wrap">
      The interactive previews and chapter buttons need JavaScript. The native
      screenshots, film controls, transcript, setup instructions, and policy
      pages remain available below.
    </p>
  </noscript>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <div class="hero-eyebrow">
        <span class="status-dot" /> PEAK / WINDOWS UTILITY
      </div>
      <h1 id="hero-title">
        YOUR AI WORK.
        <br />
        <span class="hero-outline">IN CLEAR VIEW.</span>
      </h1>
      <p class="hero-description">
        Codex and Claude usage. Codex task activity.
        <br />
        One compact island. No constant window switching.
      </p>
      <div class="hero-actions">
        <a href="/download/" class="button button-primary">
          Get Peak for Windows <Icon name="download" size={18} />
        </a>
        <a href="#playground" class="button button-ghost">
          Explore the demo <Icon name="arrow" size={18} />
        </a>
      </div>
      <p class="hero-release-note">
        FREE RELEASE COMING SOON <span>/</span> WINDOWS 10 / 11 <span>/</span>{' '}
        X64
      </p>
    </div>
    <div class="hero-stage">
      <PeakDemo mode="hero" client:load />
      <div class="hero-stage-caption">
        <span>01 / LIVE PREVIEW</span>
        <span>Browser simulation · sample data</span>
      </div>
    </div>
  </section>
  <div class="product-strip wrap">
    <span>SMALL BY DESIGN.</span>
    <div>
      <span class="provider-wordmark">
        Cx <span>Codex</span>
      </span>
      <i>+</i>
      <span class="provider-wordmark">
        Cl <span>Claude Code</span>
      </span>
    </div>
    <p>Usage for both. Task activity for Codex.</p>
  </div>
  <Story />
  <Film />
  <section
    id="playground"
    class="playground-section section-space wrap"
    aria-labelledby="playground-title"
  >
    <div class="section-intro playground-intro">
      <span class="eyebrow">02 / INTERACTIVE PLAYGROUND</span>
      <h2 id="playground-title">
        PUT PEAK
        <br />
        THROUGH ITS PACES.
      </h2>
      <p>
        Set a state. Change the theme. Hover or tap the island.
        <br />
        Explore the behavior before you install.
      </p>
    </div>
    <PeakDemo client:visible />
    <div class="playground-disclosure">
      <span class="sample-tag">BROWSER SIMULATION</span>
      <p>
        Sample data only. No provider access or computer settings are changed.
      </p>
    </div>
  </section>
  <SettingsGallery />
  <section
    id="privacy"
    class="privacy-section wrap section-space"
    aria-labelledby="privacy-title"
  >
    <div>
      <span class="eyebrow">
        <span class="tiny-cross">+</span> LOCAL BY DESIGN
      </span>
      <h2 id="privacy-title">
        Your work stays
        <br />
        in your <span class="heading-emphasis">workspace.</span>
      </h2>
      <p>
        Peak reads what it needs, after you enable it.
        <br />
        The observations stay on your computer.
      </p>
      <a href="/privacy/" class="inline-link">
        Read the privacy notice <Icon name="diagonal" size={17} />
      </a>
    </div>
    <div class="privacy-ledger">
      <div>
        <span>01</span>
        <h3>It starts with your say-so.</h3>
        <p>
          Providers are disabled by default. Connection and monitoring are
          choices you make.
        </p>
        <Icon name="shield" />
      </div>
      <div>
        <span>02</span>
        <h3>A local window into your work.</h3>
        <p>
          No Peak telemetry or remote usage backend. Provider tools retain their
          own network behavior.
        </p>
        <Icon name="window" />
      </div>
      <div>
        <span>03</span>
        <h3>Keep what matters. Clear the rest.</h3>
        <p>
          Owned observations are bounded and pruned after seven days during
          maintenance. You can clear them or disconnect.
        </p>
        <Icon name="check" />
      </div>
    </div>
  </section>
  <section class="faq-section wrap section-space" aria-labelledby="faq-title">
    <div>
      <span class="eyebrow">
        <span class="tiny-cross">+</span> GOOD TO KNOW
      </span>
      <h2 id="faq-title">
        A few
        <br />
        <span class="heading-emphasis">answers.</span>
      </h2>
      <a href="/support/" class="inline-link">
        Setup & support <Icon name="diagonal" size={17} />
      </a>
    </div>
    <div class="faq-list">
      {faqs.map(([question, answer]) => (
        <details>
          <summary>
            {question}
            <span aria-hidden="true">+</span>
          </summary>
          <p>{answer}</p>
        </details>
      ))}
    </div>
  </section>
  <DownloadCta />
</Layout>
