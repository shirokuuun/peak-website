---
import Icon from './Icon.astro';
const chapters = [
  { at: 0, time: '00:00', label: 'Stay in the work' },
  { at: 4, time: '00:04', label: 'Your limits' },
  { at: 10, time: '00:10', label: 'Your work' },
  { at: 16, time: '00:16', label: 'Your turn' },
  { at: 21, time: '00:21', label: 'Your style' },
  { at: 27, time: '00:27', label: 'Your space' },
];
---

<section
  id="film"
  class="film-section wrap section-space"
  aria-labelledby="film-title"
>
  <div class="film-heading">
    <div>
      <span class="eyebrow">THE PRODUCT FILM</span>
      <h2 id="film-title">
        See the
        <br />
        whole picture.
      </h2>
    </div>
    <div class="film-side-note">
      <span class="film-duration">00:36</span>
      <p>
        Peak, in motion.
        <br />A closer look at the Windows app.
      </p>
    </div>
  </div>
  <div class="film-frame">
    <video
      id="peak-film"
      controls
      playsinline
      preload="none"
      poster="/media/peak-design-poster.jpg"
      aria-label="Peak — Stay in the work. A 36-second film showing the updated native design with sample data."
    >
      <source src="/media/peak-design-film.mp4" type="video/mp4" />
      <track
        default
        kind="captions"
        src="/media/peak-design-film.vtt"
        srclang="en"
        label="English descriptions"
      />
      Your browser does not support video.{' '}
      <a href="/media/peak-design-film.mp4">Open the Peak film.</a>
    </video>
  </div>
  <div class="film-chapters" aria-label="Film chapters">
    {chapters.map((chapter) => (
      <button type="button" data-film-time={chapter.at}>
        <span>{chapter.time}</span>
        {chapter.label}
        <Icon name="play" size={13} />
      </button>
    ))}
  </div>
  <div class="film-caption">
    <p>Updated native design preview · sample data · original music</p>
    <details>
      <summary>Read the film transcript</summary>
      <p>
        00:00 — Stay in the work. Your AI limits in view. Your attention where
        it belongs. The mauve Peak island shows the current native design.
      </p>
      <p>
        00:04 — Less guessing. More making. See remaining Codex and Claude usage
        in the 5-hour and weekly windows, plus reported reset times.
      </p>
      <p>
        00:10 — Keep the work in sight. The task, the project, and locally
        observed Codex activity. Activity is not completion percentage.
      </p>
      <p>
        00:16 — Your turn. A question or approval request signals when you’re
        needed. Peak observes. Review and respond in Codex.
      </p>
      <p>
        00:21 — Feels like your space. Dark, light, and a custom mauve color.
      </p>
      <p>
        00:27 — There when you need it. Choose visibility and behavior. An
        editorial animation demonstrates hovering and fading over a workspace.
      </p>
      <p>
        00:32 — Keep your head in it. Meet Peak. Free on the Microsoft Store.
        Visit peakforwindows.vercel.app.
      </p>
      <p>
        Native captures use fictional sample data. Editorial interactions and
        the latest design may differ from your installed Store build.
      </p>
    </details>
  </div>
</section>
<script>
  const video = document.querySelector<HTMLVideoElement>('#peak-film');
  document
    .querySelectorAll<HTMLButtonElement>('[data-film-time]')
    .forEach((button) =>
      button.addEventListener('click', () => {
        if (!video) return;
        const jump = () => {
          video.currentTime = Number(button.dataset.filmTime);
          void video.play().catch(() => {
            video.focus();
          });
        };
        if (video.readyState >= 1) jump();
        else {
          video.addEventListener('loadedmetadata', jump, { once: true });
          video.load();
        }
      }),
    );
</script>
