---
import release from '../data/release.json';
import { isReleaseReady } from '../lib/release.mjs';
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const href = isReleaseReady(release) ? release.storeUrl : '/download/';
---

<a href={href} class:list={['store-button', { 'store-button-small': compact }]}>
  <svg
    width="19"
    height="19"
    viewBox="0 0 20 20"
    fill="currentColor"
    aria-hidden="true"
  >
    <path d="M1 3.2 8.6 2v7H1V3.2ZM10 1.8 19 .4V9h-9V1.8ZM1 10.4h7.6v7L1 16.2v-5.8Zm9 0h9V19l-9-1.4v-7.2Z" />
  </svg>
  <span>{compact ? 'Get Peak' : 'Get Peak for Windows'}</span>
</a>
